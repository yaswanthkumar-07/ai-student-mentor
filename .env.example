# Copy to .env (never commit .env). Placeholder values are ignored by the app.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Optional integrations - the app works with local fallback data without these.
GEMINI_API_KEY=your-gemini-api-key
YOUTUBE_API_KEY=your-youtube-api-key
GITHUB_TOKEN=your-github-token
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ESCO_BASE_URL=https://ec.europa.eu/esco/api

# Optional tuning
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# EXTERNAL_APIS_ENABLED=true
# HTTP_TIMEOUT_SECONDS=8
# LOG_LEVEL=INFO
# GEMINI_MODEL=gemini-2.5-flash
# ADZUNA_COUNTRY=in
# PORT=5000
